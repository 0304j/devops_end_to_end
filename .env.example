# Copy to .env.local and fill in a password:
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real credentials.

# Used by the PostgreSQL container (compose.yaml).
POSTGRES_USER=autocare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autocare

# Used by the app and by drizzle-kit. Must match the values above.
DATABASE_URL=postgres://autocare:change-me@127.0.0.1:5432/autocare

# --- Translation (German → Arabic for the garage owner) ---
# mock  = development marker, NOT a real translation
# deepl = real translation, needs DEEPL_API_KEY (free keys end in ":fx")
# none  = no translation; notifications contain the German original
TRANSLATION_PROVIDER=mock
DEEPL_API_KEY=

# --- Notifications to the garage owner ---
# mock = writes HTML files to .notifications/ (development)
# smtp = sends e-mail via the SMTP server below
NOTIFICATION_PROVIDER=mock
NOTIFY_EMAIL_TO=werkstatt@autocare-werkstatt.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AutoCare Terminanfragen <termine@autocare-werkstatt.example>"
